<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Version>5.0.0</Version>
    <Authors>Shadowsocks community</Authors>
    <RepositoryUrl>https://github.com/SlimRG/shadowsocks-reborn</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RootNamespace>Shadowsocks</RootNamespace>
    <AssemblyName>Shadowsocks</AssemblyName>
    <ApplicationIcon>shadowsocks.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Caseless.Fody" Version="1.9.1" PrivateAssets="all" />
    <PackageReference Include="CommandLineParser" Version="2.8.0" />
    <PackageReference Include="DynamicData" Version="7.1.1" />
    <PackageReference Include="Fody" Version="6.3.0" PrivateAssets="all" />
    <PackageReference Include="GlobalHotKeyCore" Version="1.2.0" />
    <PackageReference Include="Google.Protobuf" Version="3.27.2" />
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="4.7.6" />
    <PackageReference Include="Pharmacist.Common" Version="2.0.5" />
    <PackageReference Include="ReactiveUI" Version="12.1.5" />
    <PackageReference Include="ReactiveUI.Events.WPF" Version="12.1.5" />
    <PackageReference Include="ReactiveUI.Validation" Version="1.8.6" />
    <PackageReference Include="ReactiveUI.WPF" Version="12.1.5" />
    <PackageReference Include="Splat" Version="9.8.1" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="System.Reactive" Version="5.0.0" />
    <PackageReference Include="WPFLocalizeExtension" Version="3.10.0" />
    <PackageReference Include="XAMLMarkupExtensions" Version="2.1.3" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Localization\\Strings.Designer.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\\Resources.Designer.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="View\\ConfigForm.resx">
      <DependentUpon>ConfigForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="View\\LogForm.resx">
      <DependentUpon>LogForm.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Legacy ApplicationSettingsBase files were replaced by gui-config.json.
       Remove them explicitly so an old file left in an upgraded working tree
       cannot recreate Shadowsocks.dll.config or compile the old Settings class. -->
  <ItemGroup>
    <Compile Remove="Settings.cs;Properties\\Settings.Designer.cs" />
    <None Remove="app.config;Properties\\Settings.settings" />
  </ItemGroup>

  <!-- The .NET 10 port uses the managed BCL AEAD implementation in
       Encryption\AEAD\AEADBclEncryptor.cs. SDK-style projects implicitly
       compile every *.cs file under the project directory, so legacy native
       crypto files left behind when this archive is extracted over an older
       checkout would otherwise be compiled as well. They depend on the
       removed libsscrypto resource and on fields that no longer exist. -->
  <ItemGroup>
    <Compile Remove="Encryption\AEAD\AEADMbedTLSEncryptor.cs;Encryption\AEAD\AEADOpenSSLEncryptor.cs;Encryption\AEAD\AEADSodiumEncryptor.cs" />
    <Compile Remove="Encryption\MbedTLS.cs;Encryption\OpenSSL.cs;Encryption\Sodium.cs" />
  </ItemGroup>
  <!-- Privoxy was replaced by Controller\Service\ManagedHttpProxyService.cs.
       Explicit removals keep stale files from an in-place archive upgrade out of
       SDK-style wildcard compilation and publish output. -->
  <ItemGroup>
    <Compile Remove="Controller\Service\PrivoxyRunner.cs;Controller\Service\PortForwarder.cs" />
    <None Remove="Data\privoxy.exe.gz;Data\privoxy_conf.txt" />
    <Content Remove="Data\privoxy.exe.gz;Data\privoxy_conf.txt" />
    <EmbeddedResource Remove="Data\privoxy.exe.gz;Data\privoxy_conf.txt" />
  </ItemGroup>

  <!-- dlc.dat used to be an embedded build input. Keep a stale copy left by an
       in-place archive upgrade out of project items/publish output; Local PAC now
       downloads its runtime GeoSite cache on demand. -->
  <ItemGroup>
    <None Remove="Data\dlc.dat" />
    <Content Remove="Data\dlc.dat" />
    <EmbeddedResource Remove="Data\dlc.dat" />
  </ItemGroup>

  <!-- Shadowsocks.NetworkService intentionally is NOT a ProjectReference. The helper
       is built explicitly so its framework-dependent development output cannot leak into
       the main application's product publish. -->
  <PropertyGroup>
    <NetworkServiceProject>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Shadowsocks.NetworkService\Shadowsocks.NetworkService.csproj'))</NetworkServiceProject>
    <NetworkServiceBuildDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Shadowsocks.NetworkService\bin\x64\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\'))</NetworkServiceBuildDir>
    <NetworkServiceProductPublishDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Shadowsocks.NetworkService\bin\ProductPublish\$(Configuration)\win-x64\'))</NetworkServiceProductPublishDir>
  </PropertyGroup>

  <!-- Normal Build/Debug uses the complete framework-dependent helper output. -->
  <Target Name="BuildNetworkServiceForDevelopment"
          AfterTargets="Build"
          Condition="'$(_IsPublishing)' != 'true'">
    <MSBuild Projects="$(NetworkServiceProject)"
             Targets="Build"
             BuildInParallel="false"
             RemoveProperties="PublishProfile;PublishProfileFullPath;PublishDir;PublishUrl;PublishSingleFile;PublishSelfContained;SelfContained"
             Properties="Configuration=$(Configuration);Platform=x64;NetworkServiceProductPublish=false" />
    <ItemGroup>
      <NetworkServiceDevelopmentOutput Include="$(NetworkServiceBuildDir)Shadowsocks.NetworkService.*" />
    </ItemGroup>
    <Copy SourceFiles="@(NetworkServiceDevelopmentOutput)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(NetworkServiceDevelopmentOutput)' != ''" />
  </Target>

  <!-- Product Publish always builds the elevated helper as a self-contained x64
       single-file .NET 10 executable with no native compiler toolchain. -->
  <Target Name="PublishNetworkServiceProduct" BeforeTargets="ComputeFilesToPublish">
    <Message Importance="High" Text="Publishing Shadowsocks.NetworkService self-contained single-file helper to: $(NetworkServiceProductPublishDir)" />
    <RemoveDir Directories="$(NetworkServiceProductPublishDir)" />
    <MSBuild Projects="$(NetworkServiceProject)"
             Targets="Restore;Publish"
             BuildInParallel="false"
             RemoveProperties="PublishProfile;PublishProfileFullPath;PublishDir;PublishUrl;PublishSingleFile;PublishSelfContained;SelfContained;RuntimeIdentifier;Platform;PlatformTarget"
             Properties="Configuration=$(Configuration);Platform=x64;NetworkServiceProductPublish=true" />

    <ItemGroup>
      <NetworkServiceProductFiles Include="$(NetworkServiceProductPublishDir)**\*" />
    </ItemGroup>
    <Message Importance="High"
             Text="NetworkService product output: @(NetworkServiceProductFiles->'%(FullPath)', ', ')" />
    <Error Condition="!Exists('$(NetworkServiceProductPublishDir)Shadowsocks.NetworkService.exe')"
           Text="Shadowsocks.NetworkService single-file publish did not produce $(NetworkServiceProductPublishDir)Shadowsocks.NetworkService.exe. Files found: @(NetworkServiceProductFiles->'%(FullPath)', ', ')" />
    <Error Condition="Exists('$(NetworkServiceProductPublishDir)Shadowsocks.NetworkService.dll') Or Exists('$(NetworkServiceProductPublishDir)Shadowsocks.NetworkService.deps.json') Or Exists('$(NetworkServiceProductPublishDir)Shadowsocks.NetworkService.runtimeconfig.json') Or Exists('$(NetworkServiceProductPublishDir)coreclr.dll') Or Exists('$(NetworkServiceProductPublishDir)clrjit.dll') Or Exists('$(NetworkServiceProductPublishDir)hostfxr.dll') Or Exists('$(NetworkServiceProductPublishDir)hostpolicy.dll')"
           Text="Shadowsocks.NetworkService product publish is not a one-file deployment. Sidecar runtime files were produced in $(NetworkServiceProductPublishDir). Files found: @(NetworkServiceProductFiles->'%(FullPath)', ', ')" />
  </Target>

  <!-- Copy the verified helper after the main SDK has populated the publish directory.
       Any stale helper files from an older publish are removed first. -->
  <Target Name="CopyNetworkServiceProductToPublish"
          AfterTargets="CopyFilesToPublishDirectory"
          DependsOnTargets="PublishNetworkServiceProduct">
    <ItemGroup>
      <StaleNetworkServiceProductFiles Include="$(PublishDir)Shadowsocks.NetworkService.*" />
    </ItemGroup>
    <Delete Files="@(StaleNetworkServiceProductFiles)"
            Condition="'@(StaleNetworkServiceProductFiles)' != ''" />
    <Copy SourceFiles="$(NetworkServiceProductPublishDir)Shadowsocks.NetworkService.exe"
          DestinationFiles="$(PublishDir)Shadowsocks.NetworkService.exe"
          OverwriteReadOnlyFiles="true" />
    <Message Importance="High"
             Text="Published verified single-file NetworkService helper: $(PublishDir)Shadowsocks.NetworkService.exe" />
  </Target>

</Project>

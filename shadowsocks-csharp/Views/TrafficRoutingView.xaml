<UserControl
    x:Class="Shadowsocks.Views.TrafficRoutingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:ResxLocalizationProvider.DefaultAssembly="Shadowsocks"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="trafficRoutingDescriptionTextBlock" Grid.Row="0"
                   Margin="0 0 0 10" TextWrapping="Wrap" Text="{lex:Loc}" />

        <GroupBox Grid.Row="1" Margin="0 0 0 10">
            <GroupBox.Header>
                <TextBlock x:Name="trafficCaptureModeHeaderTextBlock" Text="{lex:Loc}" />
            </GroupBox.Header>
            <StackPanel Margin="10 6">
                <RadioButton x:Name="userModeRadioButton" Margin="0 2" Content="{lex:Loc}" />
                <TextBlock x:Name="userModeDescriptionTextBlock" Margin="22 0 0 6"
                           TextWrapping="Wrap" Opacity="0.75" Text="{lex:Loc}" />
                <RadioButton x:Name="adminModeRadioButton" Margin="0 2" Content="{lex:Loc}" />
                <TextBlock x:Name="adminModeDescriptionTextBlock" Margin="22 0 0 2"
                           TextWrapping="Wrap" Opacity="0.75" Text="{lex:Loc}" />
            </StackPanel>
        </GroupBox>

        <TextBlock x:Name="applicationRulesHeaderTextBlock" Grid.Row="2"
                   Margin="2 0 0 5" FontWeight="SemiBold" Text="{lex:Loc}" />

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="applicationRulesGrid" Grid.Column="0" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                      Margin="0 0 8 0" MinHeight="170">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Width="72" Binding="{Binding Enabled, Mode=TwoWay}">
                        <DataGridCheckBoxColumn.Header>
                            <TextBlock x:Name="enabledColumnHeaderTextBlock" Text="{lex:Loc}" />
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>
                    <DataGridTextColumn Width="*" Binding="{Binding Application, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridTextColumn.Header>
                            <TextBlock x:Name="applicationColumnHeaderTextBlock" Text="{lex:Loc}" />
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="125">
                        <DataGridTemplateColumn.Header>
                            <TextBlock x:Name="routeColumnHeaderTextBlock" Text="{lex:Loc}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.RouteChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Action"
                                          SelectedValue="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Column="1">
                <Button x:Name="addApplicationRuleButton" Width="96" Margin="0 0 0 6" Content="{lex:Loc}" Click="AddApplicationRuleButton_Click" />
                <Button x:Name="removeApplicationRuleButton" Width="96" Content="{lex:Loc}" Click="RemoveApplicationRuleButton_Click" />
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="4" Margin="0 12 0 0">
            <GroupBox.Header>
                <TextBlock x:Name="gameModeHeaderTextBlock" Text="{lex:Loc}" />
            </GroupBox.Header>
            <Grid Margin="10 6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="gameModeDescriptionTextBlock" Grid.Row="0" Margin="0 0 0 5"
                           TextWrapping="Wrap" Text="{lex:Loc}" />
                <TextBox x:Name="gameApplicationsTextBox" Grid.Row="1" MinHeight="70"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
            </Grid>
        </GroupBox>

        <TextBlock x:Name="dnsPolicyPlannedTextBlock" Grid.Row="5" Margin="2 10 2 0"
                   TextWrapping="Wrap" Opacity="0.7" Text="{lex:Loc}" />

        <StackPanel Grid.Row="6" Margin="0 12 0 0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="saveTrafficRoutingButton" MinWidth="92" Margin="4 0" Content="{lex:Loc}" Click="SaveTrafficRoutingButton_Click" />
            <Button x:Name="cancelTrafficRoutingButton" MinWidth="92" Margin="4 0" Content="{lex:Loc}" Click="CancelTrafficRoutingButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>

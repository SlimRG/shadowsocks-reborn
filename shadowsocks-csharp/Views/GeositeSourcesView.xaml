<reactiveui:ReactiveUserControl
    x:Class="Shadowsocks.Views.GeositeSourcesView"
    x:TypeArguments="vms:GeositeSourcesViewModel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vms="clr-namespace:Shadowsocks.ViewModels"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:lex="http://wpflocalizeextension.codeplex.com"
    lex:LocalizeDictionary.DesignCulture="en"
    lex:ResxLocalizationProvider.DefaultAssembly="Shadowsocks"
    lex:ResxLocalizationProvider.DefaultDictionary="Strings"
    mc:Ignorable="d"
    d:DesignHeight="470" d:DesignWidth="720">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="geositeSourcesDescriptionTextBlock"
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="4 0 4 10" TextWrapping="Wrap"
                   Text="{lex:Loc}" />

        <ListBox x:Name="sourcesListBox" Grid.Row="1" Grid.Column="0"
                 Margin="4" MinHeight="220" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8 4 4 4">
            <Button x:Name="moveUpButton" Width="92" Margin="0 0 0 6" Content="{lex:Loc}" />
            <Button x:Name="moveDownButton" Width="92" Margin="0 0 0 6" Content="{lex:Loc}" />
            <Button x:Name="removeButton" Width="92" Margin="0 6 0 6" Content="{lex:Loc}" />
            <Button x:Name="restoreDefaultButton" Width="92" Margin="0 14 0 6" Content="{lex:Loc}" />
        </StackPanel>

        <TextBlock x:Name="addGeositeSourcesTextBlock"
                   Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="4 10 4 4"
                   Text="{lex:Loc}" />

        <TextBox x:Name="addressTextBox" Grid.Row="3" Grid.Column="0"
                 Margin="4" MinHeight="58" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" />
        <Button x:Name="addButton" Grid.Row="3" Grid.Column="1"
                Width="92" Margin="8 4 4 4" Content="{lex:Loc}" />

        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    Margin="4 12 4 0" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="saveButton" MinWidth="90" Margin="4" Content="{lex:Loc}" />
            <Button x:Name="cancelButton" MinWidth="90" Margin="4" Content="{lex:Loc}" />
        </StackPanel>
    </Grid>
</reactiveui:ReactiveUserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Version>5.0.0</Version>
    <Authors>Shadowsocks community</Authors>
    <RepositoryUrl>https://github.com/SlimRG/shadowsocks-reborn</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RootNamespace>Shadowsocks</RootNamespace>
    <AssemblyName>Shadowsocks.Engine</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseSystemDrawing>true</UseSystemDrawing>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Caseless.Fody" Version="1.9.1" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.3.0" PrivateAssets="all" />
    <PackageReference Include="Google.Protobuf" Version="3.27.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="4.7.6" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\abp.js" LogicalName="Shadowsocks.Engine.Data.abp.js" />
    <EmbeddedResource Include="Data\i18n.csv" LogicalName="Shadowsocks.Engine.Data.i18n.csv" />
    <EmbeddedResource Include="Data\NLog.config" LogicalName="Shadowsocks.Engine.Data.NLog.config" />
    <EmbeddedResource Include="Data\user-rule.txt" LogicalName="Shadowsocks.Engine.Data.user-rule.txt" />
  </ItemGroup>
</Project>

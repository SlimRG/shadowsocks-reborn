<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Authors>Shadowsocks community</Authors>
    <RepositoryUrl>https://github.com/SlimRG/shadowsocks-reborn</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RootNamespace>Shadowsocks</RootNamespace>
    <AssemblyName>Shadowsocks.Windows</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- This is a reusable class library, not a deployable application.
         Keep its output RID-neutral so WinUI XAML/design-time builds and
         normal MSBuild ProjectReference resolution use the same path. -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
<ItemGroup>
    <ProjectReference Include="..\Shadowsocks.Core\Shadowsocks.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Caseless.Fody" Version="1.9.1" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>
</Project>

{
  "Logging": {
    "FilePath": "shadowsocks.log",
    "FallbackFilePath": "shadowsocks.log",
    "MinimumLevel": "Info",
    "VerboseMinimumLevel": "Debug",
    "ArchiveAboveSizeBytes": 10485760,
    "MaxArchiveFiles": 7,
    "MaxArchiveDays": 7,
    "Layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}"
  }
}
